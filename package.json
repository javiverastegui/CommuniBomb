{
  "name": "communibomb",
  "version": "1.0.0",
  "private": true,
  "description": "Juego cooperativo de desactivación de bombas inspirado en Keep Talking and Nobody Explodes",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c yellow,cyan \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js"
  },
  "engines": { "node": ">=18" },
  "dependencies": {
    "express": "^4.21.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "socket.io-client": "^4.8.1",
    "three": "^0.170.0",
    "vite": "^6.0.7"
  }
}
